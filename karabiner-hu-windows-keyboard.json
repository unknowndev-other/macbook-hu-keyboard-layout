{
  "title": "Hungarian Windows keyboard on macOS (external keyboard only)",
  "rules": [
    {
      "description": "1. External keyboard: Ctrl -> Command, Win -> Control (Alt and AltGr stay Option, AltGr is needed for @ { } [ ] \\ | €). Enable this rule first.",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [
            {
              "type": "device_unless",
              "identifiers": [
                {
                  "is_built_in_keyboard": true
                }
              ]
            }
          ],
          "from": {
            "key_code": "left_control",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "left_command"
            }
          ]
        },
        {
          "type": "basic",
          "conditions": [
            {
              "type": "device_unless",
              "identifiers": [
                {
                  "is_built_in_keyboard": true
                }
              ]
            }
          ],
          "from": {
            "key_code": "right_control",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "right_command"
            }
          ]
        },
        {
          "type": "basic",
          "conditions": [
            {
              "type": "device_unless",
              "identifiers": [
                {
                  "is_built_in_keyboard": true
                }
              ]
            }
          ],
          "from": {
            "key_code": "left_command",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "left_control"
            }
          ]
        },
        {
          "type": "basic",
          "conditions": [
            {
              "type": "device_unless",
              "identifiers": [
                {
                  "is_built_in_keyboard": true
                }
              ]
            }
          ],
          "from": {
            "key_code": "right_command",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "right_control"
            }
          ]
        }
      ]
    },
    {
      "description": "2. External keyboard: Home / End jump to start / end of line (with Shift: select)",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [
            {
              "type": "device_unless",
              "identifiers": [
                {
                  "is_built_in_keyboard": true
                }
              ]
            }
          ],
          "from": {
            "key_code": "home",
            "modifiers": {
              "optional": [
                "shift"
              ]
            }
          },
          "to": [
            {
              "key_code": "left_arrow",
              "modifiers": [
                "command"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "conditions": [
            {
              "type": "device_unless",
              "identifiers": [
                {
                  "is_built_in_keyboard": true
                }
              ]
            }
          ],
          "from": {
            "key_code": "end",
            "modifiers": {
              "optional": [
                "shift"
              ]
            }
          },
          "to": [
            {
              "key_code": "right_arrow",
              "modifiers": [
                "command"
              ]
            }
          ]
        }
      ]
    },
    {
      "description": "3. External keyboard: Ctrl+Home / Ctrl+End jump to start / end of document (with Shift: select)",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [
            {
              "type": "device_unless",
              "identifiers": [
                {
                  "is_built_in_keyboard": true
                }
              ]
            }
          ],
          "from": {
            "key_code": "home",
            "modifiers": {
              "mandatory": [
                "command"
              ],
              "optional": [
                "shift"
              ]
            }
          },
          "to": [
            {
              "key_code": "up_arrow",
              "modifiers": [
                "command"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "conditions": [
            {
              "type": "device_unless",
              "identifiers": [
                {
                  "is_built_in_keyboard": true
                }
              ]
            }
          ],
          "from": {
            "key_code": "end",
            "modifiers": {
              "mandatory": [
                "command"
              ],
              "optional": [
                "shift"
              ]
            }
          },
          "to": [
            {
              "key_code": "down_arrow",
              "modifiers": [
                "command"
              ]
            }
          ]
        }
      ]
    },
    {
      "description": "4. External keyboard: Ctrl+Left/Right move by word, Ctrl+Backspace / Ctrl+Delete delete a word",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [
            {
              "type": "device_unless",
              "identifiers": [
                {
                  "is_built_in_keyboard": true
                }
              ]
            }
          ],
          "from": {
            "key_code": "left_arrow",
            "modifiers": {
              "mandatory": [
                "command"
              ],
              "optional": [
                "shift"
              ]
            }
          },
          "to": [
            {
              "key_code": "left_arrow",
              "modifiers": [
                "option"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "conditions": [
            {
              "type": "device_unless",
              "identifiers": [
                {
                  "is_built_in_keyboard": true
                }
              ]
            }
          ],
          "from": {
            "key_code": "right_arrow",
            "modifiers": {
              "mandatory": [
                "command"
              ],
              "optional": [
                "shift"
              ]
            }
          },
          "to": [
            {
              "key_code": "right_arrow",
              "modifiers": [
                "option"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "conditions": [
            {
              "type": "device_unless",
              "identifiers": [
                {
                  "is_built_in_keyboard": true
                }
              ]
            }
          ],
          "from": {
            "key_code": "delete_or_backspace",
            "modifiers": {
              "mandatory": [
                "command"
              ]
            }
          },
          "to": [
            {
              "key_code": "delete_or_backspace",
              "modifiers": [
                "option"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "conditions": [
            {
              "type": "device_unless",
              "identifiers": [
                {
                  "is_built_in_keyboard": true
                }
              ]
            }
          ],
          "from": {
            "key_code": "delete_forward",
            "modifiers": {
              "mandatory": [
                "command"
              ]
            }
          },
          "to": [
            {
              "key_code": "delete_forward",
              "modifiers": [
                "option"
              ]
            }
          ]
        }
      ]
    }
  ]
}